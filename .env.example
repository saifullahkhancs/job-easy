# ─────────────────────────────────────────────────────────────────────────
# Job Easy — environment template
# Copy this file to `.env` (gitignored) and fill in the blanks.
# ─────────────────────────────────────────────────────────────────────────

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost/job_easy

# Security (generate with: openssl rand -hex 32)
JWT_SECRET=your-strong-secret-key
ENVIRONMENT=development

# ── AI Job Description Matcher ───────────────────────────────────────────
# Both providers have a FREE tier — no credit card required.
#   Gemini: get a free key at https://aistudio.google.com/app/apikey
#   Groq:   get a free key at https://console.groq.com/keys
# Set ONE of the keys below (or both) and leave AI_PROVIDER=auto.
# AI_PROVIDER=auto            # auto | gemini | groq
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# Per-user daily cap (protects the shared free-tier key)
# AI_MATCH_DAILY_LIMIT=20
# AI_MATCH_MIN_CHARS=120
# AI_MATCH_MAX_CHARS=12000

# ── Email (SMTP / Resend) ────────────────────────────────────────────────
# SMTP_PASSWORD doubles as the Resend API key.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_FROM_EMAIL=info@jobeasy.online
SMTP_FROM_NAME=Job Easy
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# CORS (comma separated)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
