# ─────────────────────────────────────────────────────────────────────────
# Job Easy — environment template
# Copy this file to `.env` (gitignored) and fill in the blanks.
# ─────────────────────────────────────────────────────────────────────────

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost/job_easy

# Security (generate with: openssl rand -hex 32)
JWT_SECRET=your-strong-secret-key
ENVIRONMENT=development

# ── AI Job Description Matcher ───────────────────────────────────────────
# All providers have a FREE tier — no credit card required.
#   Gemini:     get a free key at https://aistudio.google.com/app/apikey
#   Groq:       get a free key at https://console.groq.com/keys
#   OpenRouter: get a free key at https://openrouter.ai/keys (use a ":free" model)
# Set ONE of the keys below (or several) and leave AI_PROVIDER=auto.
# AI_PROVIDER=auto            # auto | gemini | groq | openrouter
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.6-27b   # Groq retires models often; see console.groq.com/docs/models
# GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free  # free models rotate; see openrouter.ai/models
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Per-user daily cap (protects the shared free-tier key)
# AI_MATCH_DAILY_LIMIT=20
# AI_MATCH_MIN_CHARS=120
# AI_MATCH_MAX_CHARS=4000     # keep small: Groq free tier caps tokens per minute

# ── Email (SMTP / Resend) ────────────────────────────────────────────────
# SMTP_PASSWORD doubles as the Resend API key.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_FROM_EMAIL=info@jobeasy.online
SMTP_FROM_NAME=Job Easy
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# CORS (comma separated)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
